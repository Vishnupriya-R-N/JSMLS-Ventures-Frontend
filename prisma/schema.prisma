
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String   @id @default(uuid())
  userId          String   @unique

  fullName        String
  email           String   @unique
  mobile          String?  @unique
  passwordHash    String

  role            Role     @default(PARTICIPANT)
  isVerified      Boolean  @default(false)
  isApproved      Boolean  @default(false)

  otpVerification   OtpVerification?
  passwordResetOtp PasswordResetOtp?

  // Referral relationships
  referralsMade    Referral[] @relation("Referrer")
  referralReceived Referral?  @relation("ReferredUser")

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model OtpVerification {
  id              String   @id @default(uuid())

  userId          String   @unique
  otpHash         String
  expiresAt       DateTime

  lastSentAt      DateTime
  windowStartedAt DateTime
  requestCount    Int      @default(1)

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model PasswordResetOtp {
  id              String   @id @default(uuid())
  userId          String   @unique
  otpHash         String
  expiresAt       DateTime

  lastSentAt      DateTime
  windowStartedAt DateTime
  requestCount    Int      @default(1)
  attempts        Int      @default(0)

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Referral {
  id              String   @id @default(uuid())

  referrerId      String
  referredUserId  String   @unique

  referrer        User     @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referredUser    User     @relation("ReferredUser", fields: [referredUserId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())

  @@index([referrerId])
}

enum Role {
  PARTICIPANT
  ADMIN
  FINANCE_OFFICER
  SUPER_ADMIN
}

model StageConfiguration {
  id          String @id @default(uuid())
  stageNumber Int    @unique

  firstPersonFigure  Decimal @db.Decimal(12, 2)
  secondPersonFigure Decimal @db.Decimal(12, 2)
  thirdPersonFigure  Decimal @db.Decimal(12, 2)

  level12Total Decimal @db.Decimal(12, 2)
  level3Total  Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}